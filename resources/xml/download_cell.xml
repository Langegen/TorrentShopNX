<brls:Box
    width="auto"
    height="auto"
    focusable="true"
    paddingTop="12"
    paddingBottom="12"
    paddingLeft="15"
    paddingRight="15"
    axis="column"
    cornerRadius="8">

    <!-- Main Card Header Row -->
    <brls:Box
        width="auto"
        height="114px"
        axis="row"
        alignItems="center">

        <!-- Cover Image -->
        <brls:Image
            id="cover"
            width="60px"
            height="100px"
            marginRight="18" />

        <!-- Details Column -->
        <brls:Box
            width="auto"
            height="auto"
            grow="1.0"
            axis="column"
            marginRight="15">

            <!-- Title & Count Badge Row -->
            <brls:Box width="auto" height="auto" axis="row" alignItems="center" marginBottom="4">
                <brls:Label
                    id="title"
                    fontSize="18"
                    grow="1.0"
                    singleLine="true" />
                <brls:Label
                    id="countBadge"
                    fontSize="12"
                    textColor="#AAAAAA"
                    marginLeft="10"
                    singleLine="true" />
            </brls:Box>

            <!-- Download Progress Bar Row -->
            <brls:Box width="auto" height="18px" axis="row" alignItems="center" marginBottom="3">
                <brls:Label text="@i18n/app/downloads/download_label" fontSize="12" width="115px" singleLine="true" />
                <brls:Box id="progressBarBg" width="275px" height="8px" backgroundColor="#444444" cornerRadius="4">
                    <brls:Box id="progressBar" width="0" height="8px" backgroundColor="#4CAF50" cornerRadius="4" />
                </brls:Box>
                <brls:Label id="progressText" text="0%" fontSize="12" marginLeft="10" singleLine="true" />
            </brls:Box>

            <!-- Install Progress Bar Row -->
            <brls:Box id="installProgressRow" width="auto" height="18px" axis="row" alignItems="center" marginBottom="3">
                <brls:Label text="@i18n/app/downloads/install_label" fontSize="12" width="115px" singleLine="true" />
                <brls:Box id="installBarBg" width="275px" height="8px" backgroundColor="#444444" cornerRadius="4">
                    <brls:Box id="installBar" width="0" height="8px" backgroundColor="#2196F3" cornerRadius="4" />
                </brls:Box>
                <brls:Label id="installText" text="0%" fontSize="12" marginLeft="10" singleLine="true" />
            </brls:Box>

            <!-- Stats & Expand Hint Row -->
            <brls:Box width="auto" height="auto" axis="row" alignItems="center" justifyContent="spaceBetween">
                <brls:Box width="auto" height="auto" axis="row">
                    <brls:Label id="statsText" fontSize="12" textColor="#AAAAAA" marginRight="16" />
                    <brls:Label id="elapsedText" fontSize="12" textColor="#AAAAAA" marginRight="16" />
                    <brls:Label id="peersText" fontSize="12" textColor="#AAAAAA" />
                </brls:Box>
                <brls:Label id="expandHint" fontSize="12" textColor="#00C8F5" singleLine="true" />
            </brls:Box>

        </brls:Box>

        <!-- SDK Warning Box -->
        <brls:Box
            id="sdkWarningBox"
            width="auto"
            height="auto"
            axis="column"
            alignItems="center"
            justifyContent="center"
            marginRight="15"
            visibility="gone">
            <brls:Label id="sdkConsoleLabel" text="" fontSize="11" textColor="@theme/brls/header/subtitle" marginBottom="2" />
            <brls:Label id="sdkGameLabel" text="" fontSize="12" textColor="#FF7043" />
        </brls:Box>

        <!-- Overall Status Text -->
        <brls:Label
            id="statusText"
            width="140px"
            horizontalAlign="center"
            fontSize="14" />

    </brls:Box>

    <!-- Accordion Components Box (populated dynamically in C++) -->
    <brls:Box
        id="componentsBox"
        width="auto"
        height="auto"
        axis="column"
        marginTop="10"
        visibility="gone" />

</brls:Box>
