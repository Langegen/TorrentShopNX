<brls:Box
    width="auto"
    height="130px"
    focusable="true"
    padding="15"
    axis="row"
    alignItems="center">

    <!-- Cover -->
    <brls:Image
        id="cover"
        width="60px"
        height="100px"
        marginRight="20" />

    <!-- Details Column -->
    <brls:Box
        width="auto"
        height="auto"
        grow="1.0"
        axis="column"
        marginRight="20">

        <!-- Title -->
        <brls:Label
            id="title"
            fontSize="18"
            marginBottom="5" />

        <!-- Download Progress Bar -->
        <brls:Box width="auto" height="15px" axis="row" alignItems="center" marginBottom="5">
            <brls:Label text="Загрузка: " fontSize="12" width="80px" />
            <brls:Box id="progressBarBg" width="300px" height="10px" backgroundColor="#444444" cornerRadius="5">
                <brls:Box id="progressBar" width="0" height="10px" backgroundColor="#4CAF50" cornerRadius="5" />
            </brls:Box>
            <brls:Label id="progressText" text="0%" fontSize="12" marginLeft="10" />
        </brls:Box>

        <!-- Install Progress Bar -->
        <brls:Box id="installProgressRow" width="auto" height="15px" axis="row" alignItems="center" marginBottom="5">
            <brls:Label text="Установка: " fontSize="12" width="80px" />
            <brls:Box id="installBarBg" width="300px" height="10px" backgroundColor="#444444" cornerRadius="5">
                <brls:Box id="installBar" width="0" height="10px" backgroundColor="#2196F3" cornerRadius="5" />
            </brls:Box>
            <brls:Label id="installText" text="0%" fontSize="12" marginLeft="10" />
        </brls:Box>

        <!-- Stats text: speed, ETA, size -->
        <brls:Box width="auto" height="auto" axis="row">
            <brls:Label
                id="statsText"
                fontSize="12"
                textColor="#AAAAAA"
                marginRight="20" />

            <brls:Label
                id="peersText"
                fontSize="12"
                textColor="#AAAAAA" />
        </brls:Box>

    </brls:Box>

    <!-- Status Text / Controls -->
    <brls:Label
        id="statusText"
        width="150px"
        horizontalAlign="center"
        fontSize="14" />

</brls:Box>
