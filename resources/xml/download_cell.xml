<brls:Box
    width="auto"
    height="138px"
    focusable="true"
    padding="15"
    axis="row"
    alignItems="center">

    <!-- Cover -->
    <brls:Image
        id="cover"
        width="60px"
        height="100px"
        marginRight="20" />

    <!-- Details Column -->
    <brls:Box
        width="auto"
        height="auto"
        grow="1.0"
        axis="column"
        marginRight="20">

        <!-- Title -->
        <brls:Label
            id="title"
            fontSize="17"
            marginBottom="2"
            singleLine="true" />

        <!-- File Name (for NSP / NSZ / XCI) -->
        <brls:Label
            id="fileName"
            fontSize="12"
            textColor="#AAAAAA"
            marginBottom="4"
            singleLine="true" />

        <!-- Download Progress Bar -->
        <brls:Box width="auto" height="18px" axis="row" alignItems="center" marginBottom="4">
            <brls:Label text="@i18n/app/downloads/download_label" fontSize="12" width="115px" singleLine="true" />
            <brls:Box id="progressBarBg" width="275px" height="10px" backgroundColor="#444444" cornerRadius="5">
                <brls:Box id="progressBar" width="0" height="10px" backgroundColor="#4CAF50" cornerRadius="5" />
            </brls:Box>
            <brls:Label id="progressText" text="0%" fontSize="12" marginLeft="10" singleLine="true" />
        </brls:Box>

        <!-- Install Progress Bar -->
        <brls:Box id="installProgressRow" width="auto" height="18px" axis="row" alignItems="center" marginBottom="4">
            <brls:Label text="@i18n/app/downloads/install_label" fontSize="12" width="115px" singleLine="true" />
            <brls:Box id="installBarBg" width="275px" height="10px" backgroundColor="#444444" cornerRadius="5">
                <brls:Box id="installBar" width="0" height="10px" backgroundColor="#2196F3" cornerRadius="5" />
            </brls:Box>
            <brls:Label id="installText" text="0%" fontSize="12" marginLeft="10" singleLine="true" />
        </brls:Box>

        <!-- Stats text: speed, ETA, size -->
        <brls:Box width="auto" height="auto" axis="row">
            <brls:Label
                id="statsText"
                fontSize="12"
                textColor="#AAAAAA"
                marginRight="20" />

            <brls:Label
                id="elapsedText"
                fontSize="12"
                textColor="#AAAAAA"
                marginRight="20" />

            <brls:Label
                id="peersText"
                fontSize="12"
                textColor="#AAAAAA" />
        </brls:Box>

    </brls:Box>

    <!-- SDK Mismatch Warning Box -->
    <brls:Box
        id="sdkWarningBox"
        width="auto"
        height="auto"
        axis="column"
        alignItems="center"
        justifyContent="center"
        marginRight="20"
        visibility="gone">

        <brls:Label
            id="sdkConsoleLabel"
            text=""
            fontSize="12"
            textColor="@theme/brls/header/subtitle"
            marginBottom="3" />

        <brls:Label
            id="sdkGameLabel"
            text=""
            fontSize="13"
            textColor="#FF7043" />
    </brls:Box>

    <!-- Status Text / Controls -->
    <brls:Label
        id="statusText"
        width="150px"
        horizontalAlign="center"
        fontSize="14" />

</brls:Box>
