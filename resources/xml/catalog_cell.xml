<brls:Box
    width="auto"
    height="auto"
    axis="row"
    justifyContent="spaceEvenly"
    paddingTop="8"
    paddingBottom="8">

    <!-- Card 0 -->
    <brls:Box id="card0" width="160px" height="302px" axis="column" focusable="true" padding="5" cornerRadius="10">
        <brls:Box width="150px" height="245px" cornerRadius="8">
            <brls:Image id="cover0" width="150px" height="245px" cornerRadius="8" />
            <brls:Label id="lang0" positionType="absolute" positionLeft="5px" positionBottom="5px" fontSize="10.5" textColor="#FFFFFF" backgroundColor="#E91E63" cornerRadius="4" />
            <brls:Label id="stats0" positionType="absolute" positionRight="5px" positionBottom="5px" fontSize="10" textColor="#FFFFFF" backgroundColor="#000000B0" cornerRadius="4" visibility="gone" />
        </brls:Box>
        <brls:Label id="title0" width="150px" maxWidth="150px" height="22px" fontSize="13.5" marginTop="4" horizontalAlign="left" verticalAlign="center" singleLine="true" autoAnimate="false" />
        <brls:Box width="150px" axis="row" alignItems="center" justifyContent="spaceBetween" marginTop="2">
            <brls:Label id="size0" fontSize="11" textColor="#888888" singleLine="true" />
            <brls:Box id="statsBox0" axis="row" alignItems="center" visibility="gone">
                <brls:Label id="seeds0" fontSize="11" textColor="#34C759" singleLine="true" />
                <brls:Label text=" / " fontSize="10" textColor="#666666" singleLine="true" />
                <brls:Label id="leeches0" fontSize="11" textColor="#FF453A" singleLine="true" />
            </brls:Box>
        </brls:Box>
    </brls:Box>

