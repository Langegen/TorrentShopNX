    paddingBottom="10">

    <!-- Card 0 -->
    <brls:Box id="card0" width="160px" height="300px" axis="column" focusable="true" padding="5">
        <brls:Box width="150px" height="245px">
            <brls:Image id="cover0" width="150px" height="245px" />
            <brls:Label id="lang0" positionType="absolute" positionLeft="5px" positionBottom="5px" fontSize="11" textColor="#FFFFFF" backgroundColor="#E91E63" />
        </brls:Box>
        <brls:Label id="title0" width="150px" maxWidth="150px" height="20px" fontSize="14" marginTop="5" horizontalAlign="left" verticalAlign="center" singleLine="true" autoAnimate="false" />
        <brls:Label id="size0" width="150px" height="15px" fontSize="11" marginTop="2" textColor="#888888" />
    </brls:Box>

