<brls:AppletFrame headerHidden="true" footerHidden="false">
<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20"
    paddingRight="20"
    paddingBottom="20"
    paddingLeft="20">

    <!-- Topbar -->
    <brls:Box width="auto" height="60px" axis="row" alignItems="center" justifyContent="spaceBetween" marginBottom="10">
        <brls:Label id="headerTitle" text="Каталог" fontSize="28" />
        
        <!-- Search and Filter triggers -->
        <brls:Box width="auto" height="auto" axis="row" alignItems="center">
            <brls:Label id="searchHint" text="Поиск [X]" fontSize="16" textColor="#AAAAAA" marginRight="20" />
            <brls:Label id="filterHint" text="Сброс поиска [Y]" fontSize="16" textColor="#AAAAAA" />
        </brls:Box>
    </brls:Box>

    <!-- Recycler Grid -->
    <brls:RecyclerFrame
        id="recycler"
        width="auto"
        height="auto"
        paddingTop="20"
        paddingBottom="20"
        grow="1.0" />

</brls:Box>
</brls:AppletFrame>
