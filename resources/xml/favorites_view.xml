<brls:AppletFrame headerHidden="true" footerHidden="false">
<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20"
    paddingRight="20"
    paddingBottom="20"
    paddingLeft="20">

    <!-- Header -->
    <brls:Box width="auto" height="60px" axis="row" alignItems="center" marginBottom="10">
        <brls:Label text="@i18n/app/favorites/title" fontSize="28" />
    </brls:Box>

    <!-- Recycler Grid -->
    <brls:RecyclerFrame
        id="recycler"
        width="auto"
        height="auto"
        paddingTop="20"
        paddingBottom="20"
        paddingRight="30"
        grow="1.0" />

</brls:Box>
</brls:AppletFrame>
