<brls:AppletFrame
    iconInterpolation="linear"
    headerHidden="true"
    footerHidden="false">

    <brls:ScrollingFrame width="auto" height="auto" grow="1.0">
        <brls:Box width="auto" height="auto" axis="column" padding="40" justifyContent="center" alignItems="center" grow="1.0">
            
            <!-- Logo TorrentShopNX -->
            <brls:Image image="@res/img/torrentshopnx_logo.png" width="600px" height="150px" marginBottom="40" />

            <!-- Row of 5 tiles -->
            <brls:Box width="auto" height="auto" axis="row" justifyContent="center" alignItems="center">
                
                <!-- Catalog -->
                <brls:Box id="btnCatalog" width="200px" height="300px" focusable="true" marginRight="20">
                    <brls:Image image="@res/img/icon_catalog.png" width="200px" height="300px" positionType="absolute" positionLeft="0" positionTop="0" />
                    <brls:Label text="Каталог" width="200px" height="auto" fontSize="22" horizontalAlign="center" marginTop="220px" textColor="#FFFFFF" />
                </brls:Box>
 
                <!-- Remote Add -->
                <brls:Box id="btnRemoteAdd" width="200px" height="300px" focusable="true" marginRight="20">
                    <brls:Image image="@res/img/icon_remote.png" width="200px" height="300px" positionType="absolute" positionLeft="0" positionTop="0" />
                    <brls:Label text="Добавить" width="200px" height="auto" fontSize="22" horizontalAlign="center" marginTop="220px" textColor="#FFFFFF" />
                </brls:Box>
 
                <!-- Favorites -->
                <brls:Box id="btnFavorites" width="200px" height="300px" focusable="true" marginRight="20">
                    <brls:Image image="@res/img/icon_favorites.png" width="200px" height="300px" positionType="absolute" positionLeft="0" positionTop="0" />
                    <brls:Label text="Избранное" width="200px" height="auto" fontSize="22" horizontalAlign="center" marginTop="220px" textColor="#FFFFFF" />
                </brls:Box>
 
                <!-- Downloads -->
                <brls:Box id="btnDownloads" width="200px" height="300px" focusable="true" marginRight="20">
                    <brls:Image image="@res/img/icon_downloads.png" width="200px" height="300px" positionType="absolute" positionLeft="0" positionTop="0" />
                    <brls:Label id="lblDownloads" text="Загрузки" width="200px" height="auto" fontSize="22" horizontalAlign="center" marginTop="220px" textColor="#FFFFFF" />
                </brls:Box>
 
                <!-- Settings -->
                <brls:Box id="btnSettings" width="200px" height="300px" focusable="true">
                    <brls:Image image="@res/img/icon_settings.png" width="200px" height="300px" positionType="absolute" positionLeft="0" positionTop="0" />
                    <brls:Label text="Инструменты" width="200px" height="auto" fontSize="22" horizontalAlign="center" marginTop="220px" textColor="#FFFFFF" />
                </brls:Box>
 
            </brls:Box>

            <!-- Legal Disclaimer -->
            <brls:Label
                text="Disclaimer: Uses torrent protocols. Verify local torrent laws before use. Authors accept no liability for misuse."
                width="800px"
                height="auto"
                fontSize="13"
                marginTop="25px"
                textColor="#666666"
                horizontalAlign="center" />
        </brls:Box>
    </brls:ScrollingFrame>

</brls:AppletFrame>
