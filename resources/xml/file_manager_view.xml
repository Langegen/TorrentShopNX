<brls:AppletFrame headerHidden="true" footerHidden="false">
    <brls:Box
        width="auto"
        height="auto"
        grow="1.0"
        axis="column"
        paddingTop="15"
        paddingRight="20"
        paddingBottom="10"
        paddingLeft="20">

        <!-- Top Bar: Title & Path & Space -->
        <brls:Box width="auto" height="42px" axis="row" alignItems="center" justifyContent="spaceBetween" marginBottom="4">
            <brls:Box axis="row" alignItems="center" grow="1.0" marginRight="20">
                <brls:Label text="@i18n/app/file_manager/title" fontSize="24" marginRight="15" />
                <brls:Label id="currentPath" text="sdmc:/" fontSize="15" textColor="#3498db" singleLine="true" grow="1.0" />
            </brls:Box>
            <brls:Label id="spaceInfo" text="---" fontSize="13" textColor="#88CC88" />
        </brls:Box>

        <!-- Selection Bar (hidden when nothing selected) -->
        <brls:Box
            id="selectionBar"
            width="auto"
            height="34px"
            axis="row"
            alignItems="center"
            justifyContent="spaceBetween"
            paddingLeft="12"
            paddingRight="12"
            marginBottom="6"
            cornerRadius="5"
            backgroundColor="#203a43">

            <brls:Label id="selectionText" text="Выбрано: 0" fontSize="14" textColor="#00e676" />
            <brls:Label id="selectionHint" text="@i18n/app/file_manager/selection_actions_hint" fontSize="12" textColor="#b0bec5" />
        </brls:Box>

        <!-- Column Headers -->
        <brls:Box
            width="auto"
            height="24px"
            axis="row"
            alignItems="center"
            marginBottom="2"
            paddingLeft="88"
            paddingRight="46"
            lineBottom="1px"
            lineColor="#333333">

            <brls:Label text="@i18n/app/file_manager/col_name" fontSize="12" textColor="#777777" grow="1.0" marginRight="16" />
            <brls:Label text="@i18n/app/file_manager/col_size" width="130px" fontSize="12" textColor="#777777" horizontalAlign="right" marginRight="12" />
            <brls:Label text="@i18n/app/file_manager/col_date" width="140px" fontSize="12" textColor="#777777" horizontalAlign="right" />
        </brls:Box>

        <!-- Recycler file list -->
        <brls:RecyclerFrame
            id="recycler"
            width="auto"
            height="auto"
            grow="1.0"
            paddingRight="30" />

        <!-- Empty list notification -->
        <brls:Label
            id="emptyLabel"
            text="@i18n/app/file_manager/empty_folder"
            fontSize="18"
            textColor="#666666"
            horizontalAlign="center"
            marginTop="40"
            visibility="gone" />

    </brls:Box>
</brls:AppletFrame>
