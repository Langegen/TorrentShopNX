<brls:AppletFrame headerHidden="true" footerHidden="false">
<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20"
    paddingRight="32"
    paddingBottom="12"
    paddingLeft="32">

    <!-- Topbar -->
    <brls:Box width="auto" height="56px" axis="row" alignItems="center" justifyContent="spaceBetween" marginBottom="8">
        <brls:Label id="headerTitle" text="@i18n/app/collections/title" fontSize="28" />
        <brls:Label id="statsHint" text="" fontSize="15" textColor="@theme/brls/header/subtitle" />
    </brls:Box>

    <!-- Loading / error state -->
    <brls:Label id="loadingLabel" text="@i18n/app/common/loading" fontSize="18" textColor="#AAAAAA" marginTop="40" />

    <brls:Box id="emptyHolder" width="auto" height="auto" grow="1.0" axis="column" visibility="gone" />

    <!-- Games list -->
    <brls:RecyclerFrame
        id="recycler"
        width="auto"
        height="auto"
        paddingTop="10"
        paddingBottom="20"
        paddingRight="30"
        grow="1.0" />

</brls:Box>
</brls:AppletFrame>
