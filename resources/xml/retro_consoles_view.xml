<brls:AppletFrame headerHidden="true" footerHidden="false">
<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="16"
    paddingRight="36"
    paddingBottom="10"
    paddingLeft="36">

    <!-- Topbar -->
    <brls:Box width="auto" height="48px" axis="row" alignItems="center" justifyContent="spaceBetween" marginBottom="10">
        <brls:Box axis="row" alignItems="center">
            <brls:Label id="titleLabel" text="@i18n/app/retro/consoles_title" fontSize="28" />
        </brls:Box>
        <brls:Label id="statsHint" text="@i18n/app/retro/consoles_stats" fontSize="14" textColor="#90caf9" />
    </brls:Box>

    <!-- Console list in scrolling frame -->
    <brls:ScrollingFrame
        id="scroll"
        width="auto"
        height="auto"
        grow="1.0"
        marginBottom="10">
        <brls:Box id="listBox" width="auto" height="auto" axis="column" paddingLeft="14" paddingRight="24" />
    </brls:ScrollingFrame>

</brls:Box>
</brls:AppletFrame>
