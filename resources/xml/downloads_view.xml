<brls:AppletFrame headerHidden="true" footerHidden="false">
<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20"
    paddingRight="32"
    paddingBottom="12"
    paddingLeft="32">

    <!-- Header -->
    <brls:Box width="auto" height="56px" axis="row" alignItems="center" justifyContent="spaceBetween" marginBottom="8">
        <brls:Label text="@i18n/app/downloads/title" fontSize="28" />
        <brls:Box width="auto" height="auto" axis="row" alignItems="center">
            <brls:Label id="backlightHint" text="@i18n/app/downloads/action_turn_off_backlight_hint" fontSize="15" textColor="@theme/brls/header/subtitle" />
        </brls:Box>
    </brls:Box>

    <!-- Shown instead of the list when there are no downloads -->
    <brls:Box id="emptyHolder" width="auto" height="auto" grow="1.0" axis="column" visibility="gone" />

    <!-- Recycler Grid -->
    <brls:RecyclerFrame
        id="recycler"
        width="auto"
        paddingTop="20"
        paddingBottom="20"
        paddingRight="30"
        grow="1.0" />

</brls:Box>
</brls:AppletFrame>
