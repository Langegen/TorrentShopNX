<brls:AppletFrame headerHidden="true" footerHidden="false">
<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20"
    paddingRight="32"
    paddingBottom="12"
    paddingLeft="32">

    <brls:Box width="auto" height="56px" axis="row" alignItems="center" marginBottom="8">
        <brls:Label text="@i18n/app/settings/title" fontSize="28" />
    </brls:Box>

    <brls:TabFrame id="tabFrame" width="auto" height="auto" grow="1.0" />

</brls:Box>
</brls:AppletFrame>