<brls:AppletFrame headerHidden="true" footerHidden="false">
<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20"
    paddingRight="32"
    paddingBottom="12"
    paddingLeft="32">

    <!-- Topbar -->
    <brls:Box width="auto" height="56px" axis="row" alignItems="center" justifyContent="spaceBetween" marginBottom="8">
        <brls:Box axis="row" alignItems="center">
            <brls:Label id="titleLabel" text="@i18n/app/retro/emulators_title" fontSize="28" />
        </brls:Box>
        <brls:Label id="statsHint" text="@i18n/app/retro/emulators_subtitle" fontSize="15" textColor="@theme/brls/header/subtitle" />
    </brls:Box>

    <!-- Emulator list in scrolling frame -->
    <brls:ScrollingFrame
        id="scroll"
        width="auto"
        height="auto"
        grow="1.0"
        marginBottom="10">
        <brls:Box id="listBox" width="auto" height="auto" axis="column" paddingLeft="14" paddingRight="24" paddingBottom="40" />
    </brls:ScrollingFrame>

</brls:Box>
</brls:AppletFrame>
