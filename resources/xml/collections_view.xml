<brls:AppletFrame headerHidden="true" footerHidden="false">
<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20"
    paddingRight="32"
    paddingBottom="12"
    paddingLeft="32">

    <!-- Topbar -->
    <brls:Box width="auto" height="56px" axis="row" alignItems="center" marginBottom="8">
        <brls:Label text="@i18n/app/collections/title" fontSize="28" />
    </brls:Box>

    <!-- Collection list -->
    <brls:ScrollingFrame
        id="scroll"
        width="auto"
        height="auto"
        grow="1.0"
        marginBottom="10">
        <brls:Box id="listBox" width="auto" height="auto" axis="column" paddingLeft="14" paddingRight="24" />
    </brls:ScrollingFrame>

</brls:Box>
</brls:AppletFrame>
