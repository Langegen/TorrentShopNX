<brls:AppletFrame headerHidden="true" footerHidden="false">
<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20"
    paddingRight="20"
    paddingBottom="20"
    paddingLeft="20">

    <!-- Topbar -->
    <brls:Box width="auto" height="60px" axis="row" alignItems="center" justifyContent="spaceBetween" marginBottom="10">
        <brls:Label text="@i18n/app/updates/title" fontSize="28" />
        
        <brls:Box width="auto" height="auto" axis="row" alignItems="center">
            <brls:Label id="statsHint" text="@i18n/app/updates/searching" fontSize="16" textColor="#AAAAAA" />
        </brls:Box>
    </brls:Box>

    <!-- Recycler Grid -->
    <brls:RecyclerFrame
        id="recycler"
        width="auto"
        height="auto"
        paddingTop="20"
        paddingBottom="20"
        paddingRight="30"
        grow="1.0" />

</brls:Box>
</brls:AppletFrame>
