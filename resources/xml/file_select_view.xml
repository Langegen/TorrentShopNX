<brls:AppletFrame headerHidden="true" footerHidden="false">

    <brls:Box
        width="auto"
        height="auto"
        axis="column"
        padding="40"
        grow="1.0">

        <!-- Header -->
        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            alignItems="center"
            justifyContent="spaceBetween"
            marginBottom="10">

            <brls:Box
                axis="column"
                grow="1.0"
                shrink="1.0"
                marginRight="20">
                <brls:Label id="title" text="@i18n/app/fileselect/title" fontSize="26" marginBottom="4" />
                <brls:Label id="subtitle" text="@i18n/app/fileselect/subtitle" fontSize="16" textColor="@theme/brls/header/subtitle" />
            </brls:Box>

            <!-- Top-right hint for Button X (Toggle All) -->
            <brls:Box
                id="toggleAllBox"
                width="auto"
                height="40"
                axis="row"
                alignItems="center"
                paddingLeft="14"
                paddingRight="14"
                cornerRadius="8"
                focusable="false">
                <brls:Label id="toggleAllBtnIcon" fontSize="18" marginRight="8" />
                <brls:Label id="toggleAllBtnText" text="@i18n/app/actions/toggle_all" fontSize="15" />
            </brls:Box>

        </brls:Box>


        <!-- Scrollable file list -->
        <brls:ScrollingFrame
            id="fileListScroll"
            width="auto"
            height="auto"
            grow="1.0"
            marginBottom="20">

            <brls:Box
                id="fileListBox"
                width="auto"
                height="auto"
                axis="column"
                paddingRight="30" />

        </brls:ScrollingFrame>

        <!-- Bottom Summary & Storage Selector -->
        <brls:Box id="bottomSummaryBox" width="auto" axis="column" padding="15" cornerRadius="8">
            <!-- Row 1: Selected files size & Free space -->
            <brls:Box width="auto" axis="row" alignItems="center" justifyContent="spaceBetween" marginBottom="10">
                <brls:Box axis="row" alignItems="center">
                    <brls:Label text="@i18n/app/fileselect/total_selected" fontSize="16" />
                    <brls:Label id="totalSizeText" text="0 MB" fontSize="16" textColor="@theme/brls/accent" />
                </brls:Box>
                <brls:Box axis="column" alignItems="flexEnd">
                    <brls:Label id="freeSpaceSdText" text="---" fontSize="13" textColor="@theme/brls/header/subtitle" />
                    <brls:Label id="freeSpaceNandText" text="---" fontSize="13" textColor="@theme/brls/header/subtitle" />
                </brls:Box>
            </brls:Box>
            
            <!-- Row 2: Install location selector (clickable & focusable) -->
            <brls:Box id="installLocationBox" width="auto" height="50px" axis="row" alignItems="center" justifyContent="spaceBetween" paddingLeft="14" paddingRight="14" cornerRadius="8" focusable="true">
                <brls:Label id="installLocationLabel" text="@i18n/app/fileselect/install_location_lbl" fontSize="16" />
                <brls:Label id="installLocationText" text="" fontSize="16" />
            </brls:Box>
        </brls:Box>

    </brls:Box>

</brls:AppletFrame>
