<brls:Box
    width="auto"
    height="60px"
    focusable="true"
    paddingTop="15"
    paddingBottom="15"
    paddingLeft="20"
    paddingRight="20"
    axis="row"
    alignItems="center">

    <brls:Label
        id="checkbox"
        width="40px"
        height="auto"
        fontSize="24"
        marginRight="20" />

    <brls:Label
        id="fileName"
        width="auto"
        height="auto"
        grow="1.0"
        fontSize="18"
        marginRight="20" />

    <brls:Label
        id="fileSize"
        width="150px"
        height="auto"
        horizontalAlign="right"
        fontSize="16"
        textColor="#888888" />

</brls:Box>
