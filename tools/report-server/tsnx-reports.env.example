# Copy to /etc/tsnx-reports.env and fill in; keep it readable by root only:
#   sudo install -m 600 tsnx-reports.env.example /etc/tsnx-reports.env

# Bot from @BotFather and the private chat the reports go to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Topic id, only when that chat is a group with topics.
TELEGRAM_THREAD_ID=

# How long reports stay on the server, delivered or not (2-4 days: 48-96).
RETENTION_HOURS=72

# 127.0.0.1 when a reverse proxy (Caddy) in front of it handles HTTPS;
# 0.0.0.0 to accept the app directly over plain HTTP.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787
# 1 behind a reverse proxy, so rate limits see the real client address.
TRUST_PROXY=1

MAX_REPORT_MB=10
RATE_PER_IP_PER_MINUTE=3
RATE_GLOBAL_PER_MINUTE=30
