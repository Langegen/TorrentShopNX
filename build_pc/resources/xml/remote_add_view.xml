<brls:AppletFrame
    title="@i18n/app/remote/title"
    iconInterpolation="linear"
    headerHidden="false"
    footerHidden="false">

    <brls:Box focusable="true" hideHighlight="true" width="auto" height="auto" axis="column" padding="40" justifyContent="center" alignItems="center" grow="1.0">
        <brls:Label id="lblInstructions" text="@i18n/app/remote/scan_prompt" fontSize="24" marginBottom="20" />
        <brls:Label id="lblUrl" text="http://0.0.0.0:8080/" fontSize="36" marginBottom="40" />
        
        <QrCodeView id="qrView" width="300" height="300" />
        
        <brls:Label text="@i18n/app/remote/waiting" fontSize="20" marginTop="40" />
    </brls:Box>

</brls:AppletFrame>
